# TechMart RAG AI — Environment Variables
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# -----------------------------------------------
# Google Service Account (for Google Sheets API)
# -----------------------------------------------
# Download the service account JSON from Google Cloud Console
# and place it in the project root as:
#   <your-project-id>-credentials.json
# Then set the email below:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# -----------------------------------------------
# Google Sheets
# -----------------------------------------------
# The ID of your Google Sheet (found in the URL between /d/ and /edit)
# Make sure the sheet is shared with the service account email above (Editor role)
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id_here

# -----------------------------------------------
# Google Gemini API (for LLM + text embeddings)
# -----------------------------------------------
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# -----------------------------------------------
# Resend (for email notifications)
# -----------------------------------------------
# Get your key from: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
