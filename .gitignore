# =============================================
# SECURITY: Never commit credentials
# =============================================
*.json.key
sunlit-standard-*.json
*-credentials.json
*-service-account.json
service_account*.json

# Environment variables (contain API keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# =============================================
# Next.js
# =============================================
.next/
out/
build/

# =============================================
# Node.js
# =============================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# =============================================
# Data files (runtime generated, may contain PII)
# =============================================
data/orders.json
data/customers.json
data/logs.json
data/refunds.json

# Keep these (policy index is safe to commit)
!data/policy_chunks.json
!data/policy_meta.json
!data/products.json

# =============================================
# Misc
# =============================================
.DS_Store
*.pem
Thumbs.db
.vercel
*.tsbuildinfo
next-env.d.ts
